# Copy to .env.local and fill in. Never commit .env.local.
# Same Supabase project as the weddings app — copy the four values from that
# repo's .env.local. MVRK Pay only ever touches the `pay` schema in it.

# --- Phase 2: required to run the app at all -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Creating logins, cron jobs and provider credential lookups.
# Bypasses Row Level Security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only by `npm run setup:db` to apply migrations.
DATABASE_URL=

# Protects the cron endpoints (22:00 logout, day close, expiry) from anyone else.
CRON_SECRET=

# --- Phase 3: payments -----------------------------------------------------
# Provider API keys are Supabase Vault secrets named by providers.credential_ref.
# As a fallback the same name is looked up here, so this works too:
# NGENIUS_API_KEY=

# --- Phase 4: email (end-of-day report, e-receipts) ------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Phase 6: login protection ---------------------------------------------
# Admin sign-in asks for an emailed code once the service-role key and both
# Resend values are set. "off" skips it deliberately (e.g. Resend is down).
# ADMIN_EMAIL_CODE=off
